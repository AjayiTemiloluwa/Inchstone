# ─────────────────────────────────────────────────────────────
# Inchstone — local environment template
# Copy to `.env` and fill in. `.env*` is gitignored by design.
#   cp .env.example .env
# ─────────────────────────────────────────────────────────────

# ── Database (REQUIRED) ──────────────────────────────────────
# Postgres. The app uses @prisma/adapter-neon, so a Neon URL works
# directly; any standard postgres:// URL also works.
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"

# ── Clerk auth (REQUIRED) ─────────────────────────────────────
# Both keys come from https://dashboard.clerk.com → API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."

# ── Google Calendar sync (optional) ──────────────────────────
# OAuth client for the Calendar integration.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3000/api/calendar/callback"
GOOGLE_CALENDAR_ID=""

# ── Email via Resend (optional) ──────────────────────────────
RESEND_API_KEY=""
EMAIL_FROM="Inchstone <onboarding@resend.dev>"

# ── AI suggestions (optional) ────────────────────────────────
# Google Gemini key. Without it /api/ai/suggest returns 501.
GEMINI_API_KEY=""

# ── Web push / alarms (optional) ─────────────────────────────
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:you@example.com"

# ── Cron (optional) ──────────────────────────────────────────
# Shared secret for GET /api/cron/alarms. The GitHub Actions
# workflow (.github/workflows/alarm-dispatcher.yml) sends this
# as the `x-cron-secret` header.
CRON_SECRET=""

# ── Local dev ────────────────────────────────────────────────
# `npm run dev` uses port 3000. Change it if that port is busy.
# SITE_URL="http://localhost:3000"
